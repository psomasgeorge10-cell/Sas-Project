# ---------------------------------------------------------------------------
# Copy to .env.local and adjust. Every variable here is optional in development:
# with none of them set the app runs on an embedded PostgreSQL (PGlite) stored
# in ./.pglite, which is what `npm run db:setup` prepares.
# ---------------------------------------------------------------------------

# Point at a real PostgreSQL server to use it instead of the embedded database.
# Supabase:  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Neon:      postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Local:     postgresql://postgres:postgres@localhost:5432/dashboard
# DATABASE_URL=

# Apply schema.sql automatically on start-up when using a real server.
# Leave unset in production and run `npm run db:migrate` as a deploy step.
# DATABASE_AUTO_MIGRATE=false

# Secret used to sign session JWTs. REQUIRED in production - the app refuses to
# start without it. Generate one with: openssl rand -base64 32
# AUTH_SECRET=

# Password given to the seeded demo account (admin@example.com).
# SEED_ADMIN_PASSWORD=password123
